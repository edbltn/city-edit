# Git
.git/
.gitignore

# Python
env/
__pycache__/
*.pyc
.env

# Node
node_modules/

# Google Cloud SDK (don't upload to itself!)
google-cloud-sdk/
*.tar.gz

# Terraform
terraform/.terraform/
terraform/*.tfstate*

# IDE
.idea/
.vscode/

# Misc
docs/
dump.rdb
server/cache/
debug/
monitoring/

# OSM data artifacts (rebuilt in image via refresh_osm.py) — whole tree,
# including per-city subdirs (server/osm_data/<city>/walk_graph.pkl).
server/osm_data/

# Raw Lyft ride imports (one-off import_lyft.py source data, ~191M) — never
# needed in the image, don't upload to Cloud Build.
server/lyft_data/

# Blocks-pipeline artifacts + its private venv (multi-GB bake outputs; images
# get baked blocks via osm_data / the blocks overlays, never from here) and
# one-off QGIS exports.
server/streetscape_blocks/output/
server/streetscape_blocks/cache/
server/streetscape_blocks/env/
server/streetscape_blocks/eval/
exports/

# DB dumps
*.dump

# Screenshots / stray images (keep client-react favicons!)
screenshots/
Screenshot*.png
*.jpg
/*.png
