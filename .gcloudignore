# Git
.git/
.gitignore

# Python
env/
__pycache__/
*.pyc
.env

# Node
node_modules/

# Google Cloud SDK (don't upload to itself!)
google-cloud-sdk/
*.tar.gz

# Terraform
terraform/.terraform/
terraform/*.tfstate*

# IDE
.idea/
.vscode/

# Misc
docs/
dump.rdb
server/cache/
debug/
monitoring/

# OSM data artifacts (rebuilt in image via refresh_osm.py) — whole tree,
# including per-city subdirs (server/osm_data/<city>/walk_graph.pkl).
server/osm_data/

# Graph sets pulled OUT of .arrays-staging/ because their city is already baked
# into the image (staging one would overwrite the image's own pickle and shift
# that city's edge ids). Kept on disk to stay reversible, but nothing should
# ever upload them — .arrays-staging/ itself is NOT ignored, since the arrays
# overlay needs whatever city is legitimately staged there.
.arrays-staging-parked/

# Raw Lyft ride imports (one-off import_lyft.py source data, ~191M) — never
# needed in the image, don't upload to Cloud Build.
server/lyft_data/

# Blocks-pipeline artifacts + its private venv (multi-GB bake outputs; images
# get baked blocks via osm_data / the blocks overlays, never from here) and
# one-off QGIS exports.
server/streetscape_blocks/output/
server/streetscape_blocks/cache/
server/streetscape_blocks/env/
server/streetscape_blocks/eval/
exports/

# DB dumps
*.dump

# Screenshots / stray images (keep client-react favicons!)
screenshots/
Screenshot*.png
*.jpg
/*.png

# Analysis + poster pipeline artifacts (repo-root data/ only — server/data/ is
# baked into images and must keep uploading)
/data/

# Parked graph-array staging (~466M). Only .arrays-staging/ is ever COPYed by a
# Dockerfile; the parked copy is local scratch and must not ride the upload.
.arrays-staging-parked/
