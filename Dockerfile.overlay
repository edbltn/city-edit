# Overlay build — for code-only deploys (no graph-builder change).
#
# Reuses the CURRENT app image's baked per-city graphs, PMTiles, and Python venv,
# overlaying only the updated server code, built client, and nginx config. This
# keeps edge ids identical to what's already deployed (so stored votes stay
# aligned — no resnap needed) and builds in minutes instead of rebuilding every
# city graph. Use the regular Dockerfile when the graph builder itself changes.
#
# _BASE_IMAGE must be the exact (digest-pinned) image currently serving prod.

# Declared before the first FROM so it's in scope for the second stage's FROM
# (Docker only substitutes a FROM from ARGs that precede the first FROM).
ARG BASE_IMAGE

FROM node:20-alpine AS client-builder
WORKDIR /app
COPY client-react/package.json client-react/package-lock.json ./
RUN npm ci
COPY client-react/ ./
RUN npm run build

FROM ${BASE_IMAGE}
WORKDIR /app

# Updated backend + fixed station data (graphs/pmtiles/venv come from the base).
# Re-sync Python deps against the lockfile first: an overlay that ships code
# importing a package the base image predates (e.g. orjson) would otherwise
# crash at boot. Already-satisfied pins are no-ops, so this stays fast.
COPY server/requirements.txt ./
RUN uv pip install --system --no-cache -r requirements.txt
COPY server/*.py ./
COPY server/data/ ./data/

# Rebuilt client + updated nginx config.
COPY --from=client-builder /app/dist /var/www/html/
COPY deploy/nginx-cloudrun.conf /etc/nginx/nginx.conf

# Process supervisor config too — without this an overlay deploy silently keeps
# the base image's gunicorn command line (e.g. new --worker-connections knobs
# would never ship).
COPY deploy/supervisord.conf /etc/supervisor/conf.d/supervisord.conf
