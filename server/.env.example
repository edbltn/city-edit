# Redis host (default: localhost)
REDIS_HOST=localhost

# Merged-OSRM base URL. Local dev reaches the dockerized OSRM via its host port
# mapping (docker-compose.osrmport.yml publishes 5005:5000). Host port is 5005,
# NOT 5000: macOS AirPlay Receiver squats *:5000. Dockerized Flask overrides
# this with OSRM_URL=http://osrm:5000 via compose.
OSRM_URL=http://localhost:5005

# PostgreSQL database URL (optional, for persistent vote storage)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://app:devpassword@localhost:5432/votes

# Signing key for map-passcode tokens. Change in production.
SECRET_KEY=dev-secret-change-me

# Token guarding state-changing admin endpoints (e.g. assigning vanity
# subdomains via POST /api/admin/maps/<slug>/subdomain). Leave unset to disable
# those endpoints entirely; set a long random value to enable remote admin.
ADMIN_TOKEN=
