# Copy me to server/.env (the quickstart does: cd server && cp .env.example .env).
# The defaults below match the Docker services from `make deps` — a fresh clone
# should work without editing anything. docker compose also injects this file
# into the flask containers (env_file: ./server/.env); compose's own
# `environment:` entries override it there (e.g. REDIS_HOST=redis).

# ── Core services ────────────────────────────────────────────────────────────

# Redis (votes serving + pub/sub). `make deps` publishes it on localhost:6379.
REDIS_HOST=localhost
REDIS_PORT=6379

# Merged-OSRM base URL. Local dev reaches the dockerized OSRM via its host port
# mapping (docker-compose.osrmport.yml publishes 5005:5000). Host port is 5005,
# NOT 5000: macOS AirPlay Receiver squats *:5000. Dockerized Flask overrides
# this with OSRM_URL=http://osrm:5000 via compose.
OSRM_URL=http://localhost:5005

# PostgreSQL (durable vote storage; Redis is rehydrated from it on boot).
# Optional — leave unset to run without persistence.
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://app:devpassword@localhost:5432/votes

# ── Auth / signing ───────────────────────────────────────────────────────────

# Signing key for map-passcode tokens. Change in production (prod injects it
# from Secret Manager; changing it invalidates existing passcode sessions).
SECRET_KEY=dev-secret-change-me

# Token guarding state-changing admin endpoints (e.g. assigning vanity
# subdomains via POST /api/admin/maps/<slug>/subdomain). Leave unset to disable
# those endpoints entirely; set a long random value to enable remote admin.
ADMIN_TOKEN=

# ── Dev-loop knobs (all optional) ────────────────────────────────────────────

# SKIP_PREWARM=1  → skip the per-map vote/topology prewarm at boot; graphs load
#                   lazily on first request. The fast way to restart Flask.
# SKIP_WARMUP=1   → also skip the background city-graph preload entirely.
# LOG_LEVEL=DEBUG → chatty [TAG]-prefixed server logs (default INFO).
# FLASK_DEBUG=1   → Flask debug mode for the dev server (python app.py).
# PORT=5001       → dev-server port (Vite proxies /api + /ws to it).
#SKIP_PREWARM=1
#LOG_LEVEL=DEBUG

# ── Prod-only (set by terraform / Cloud Run, ignore locally) ─────────────────

# APP_ENV=staging   → staging behavior: map configs carry staging:true (client
#                     skips the canonical-subdomain redirect, shows the STAGING
#                     ribbon) and every response gets X-Robots-Tag: noindex.
# PREVIEW_BUCKET    → private GCS bucket of map screenshots; Flask streams
#                     /previews/<slug>.png from it.

# ── Tuning (defaults are fine; see vote-path saturation notes) ───────────────

# VOTE_CACHE_MAX_MB=512            bound on the per-instance vote-response LRU
# GRAPH_VOTES_DEBOUNCE=2.0         min seconds between vote-snapshot rebuilds
# VOTE_MAX_INFLIGHT=64             concurrent vote writes before queueing
# VOTE_QUEUE_WAIT_SECONDS=1.5      max queue wait before shedding (503)
# VOTE_LOCK_SHED_SECONDS=2.0       voter-lock hold before shedding
# DB_POOL_MAX=5                    Postgres connection-pool size
# MAX_DEVICES_PER_IP_PER_EDGE=10   per-IP anti-abuse cap on distinct devices
