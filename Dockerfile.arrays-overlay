# Arrays overlay build — code deploy PLUS the compact-array graph artifacts
# (walk_graph_arrays.npz) the runtime now loads instead of unpickling networkx.
#
# Same contract as Dockerfile.overlay (reuse the CURRENT app image's baked
# graphs → identical edge ids, no vote resnap), with two additions:
#   1. NEW cities absent from the base image (philly, test-cp, test-mid) are
#      staged complete in .arrays-staging/<city>/ (walk_graph.pkl, block
#      artifacts, tiles) — each set is self-consistent (blocks stamped against
#      that same pkl).
#   2. walk_graph_arrays.npz is generated IN-IMAGE from every walk_graph.pkl —
#      the base image's own pickles for the 4 baked cities — so the arrays are
#      a bit-faithful projection of exactly what prod votes/blocks reference.
#      (Local pickles are DIFFERENT builds; never ship locally-generated npz
#      for cities whose graphs are baked in the image.)
#
# _BASE_IMAGE must be the exact (digest-pinned) image currently serving prod.

ARG BASE_IMAGE

FROM node:20-alpine AS client-builder
WORKDIR /app
COPY client-react/package.json client-react/package-lock.json ./
RUN npm ci
COPY client-react/ ./
RUN npm run build

FROM ${BASE_IMAGE}
WORKDIR /app

# Updated backend (graphs/pmtiles/venv come from the base).
COPY server/requirements.txt ./
RUN uv pip install --system --no-cache -r requirements.txt
COPY server/*.py ./
COPY server/data/ ./data/

# New-city artifact sets (see header). Copied before the conversion pass so
# their pickles are converted in the same sweep as the base image's.
COPY .arrays-staging/ ./osm_data/

# Convert every city's pickle to the runtime array artifact. Needs the full
# networkx unpickle per city (~6GB transient for NYC) — run on a big Cloud
# Build machine (see cloudbuild.arrays-overlay.yaml).
RUN python graph_arrays.py --all

# Rebuilt client + updated nginx config.
COPY --from=client-builder /app/dist /var/www/html/
COPY deploy/nginx-cloudrun.conf /etc/nginx/nginx.conf
