# Blocks overlay build — code-only deploy PLUS refreshed Layer-2 block
# artifacts (edge_blocks_<network>.npy/.json + blocks.pmtiles per city).
#
# Same contract as Dockerfile.overlay (reuse the CURRENT app image's baked
# graphs → identical edge ids, no vote resnap), with one addition: block
# artifacts staged in .blocks-staging/<city>/ are copied over the image's
# osm_data. The artifacts MUST be baked against the BASE IMAGE's own
# walk_graph.pkl files (extract them from the image first — see
# streetscape_blocks/build_blocks_graph_first.py); the loader hard-rejects a
# mapping whose stamped topology_etag doesn't match the live graph.
#
# _BASE_IMAGE must be the exact (digest-pinned) image currently serving prod.

ARG BASE_IMAGE

FROM node:20-alpine AS client-builder
WORKDIR /app
COPY client-react/package.json client-react/package-lock.json ./
RUN npm ci
COPY client-react/ ./
RUN npm run build

FROM ${BASE_IMAGE}
WORKDIR /app

# Updated backend (graphs/pmtiles/venv come from the base).
COPY server/requirements.txt ./
RUN uv pip install --system --no-cache -r requirements.txt
COPY server/*.py ./
COPY server/data/ ./data/

# Refreshed block artifacts, baked against the base image's own graphs.
COPY .blocks-staging/ ./osm_data/

# Rebuilt client + updated nginx config.
COPY --from=client-builder /app/dist /var/www/html/
COPY deploy/nginx-cloudrun.conf /etc/nginx/nginx.conf
