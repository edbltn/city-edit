diff --git a/client-react/src/components/NavRail/NavRail.css b/client-react/src/components/NavRail/NavRail.css
new file mode 100644
index 0000000..87c160b
--- /dev/null
+++ b/client-react/src/components/NavRail/NavRail.css
@@ -0,0 +1,176 @@
+/* Meta nav rail — two enclosed segments of icon buttons (read | act).
+   Shared by the map topbar and the landing header. */
+
+.nav-rail {
+  /* Squares: the group's 1px border eats into the row height, so subtracting it
+     from the width keeps every button exactly square at every breakpoint. */
+  --nav-btn-size: calc(var(--control-height) - 2px);
+  --nav-icon-size: 18px;
+
+  display: flex;
+  align-items: stretch;
+  gap: var(--space-2);
+  height: var(--control-height);
+  flex-shrink: 0;
+}
+
+/* Enclosure is the grouping cue: buttons inside one box are one semantic set,
+   and the gap between boxes separates "read" from "act". */
+.nav-group {
+  display: flex;
+  align-items: stretch;
+  height: 100%;
+  box-sizing: border-box;
+  border: 1px solid var(--hairline);
+  background: var(--paper);
+}
+
+.nav-btn {
+  position: relative;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  gap: var(--space-2);
+  width: var(--nav-btn-size);
+  padding: 0;
+  border: 0;
+  background: none;
+  font-family: var(--font-main);
+  font-size: var(--control-font-size);
+  font-weight: 400;
+  color: var(--ink);
+  text-decoration: none;
+  cursor: pointer;
+  transition: background 0.12s ease, color 0.12s ease;
+}
+
+.nav-btn + .nav-btn {
+  border-left: 1px solid var(--hairline);
+}
+
+.nav-btn svg {
+  display: block;
+  width: var(--nav-icon-size);
+  height: var(--nav-icon-size);
+  flex-shrink: 0;
+}
+
+.nav-btn:hover {
+  background: var(--hover-bg);
+  color: var(--ink-strong);
+}
+
+.nav-btn:active {
+  background: var(--hover-bg-strong);
+}
+
+.nav-btn:focus-visible {
+  outline: 1px solid var(--ink-strong);
+  outline-offset: -3px;
+}
+
+/* Donate is the only labelled item: it carries the active map's accent so it's
+   the one thing in this otherwise-quiet rail that pulls the eye. Every theme
+   accent is bright enough that --on-accent (near-black) keeps contrast. */
+.nav-btn-donate {
+  width: auto;
+  padding: 0 var(--space-3);
+  background: var(--accent);
+  color: var(--on-accent);
+  font-weight: 600;
+}
+
+.nav-btn-donate:hover {
+  background: var(--accent);
+  color: var(--on-accent);
+  filter: brightness(1.12);
+}
+
+.nav-btn-donate:active {
+  background: var(--accent);
+  filter: brightness(0.94);
+}
+
+.nav-btn-label {
+  white-space: nowrap;
+}
+
+/* Tooltips — icon-only buttons need their name on hover. Same instant-reveal
+   pattern as .landing-search-tip (the native `title` waits ~500ms). Hover-only
+   media so a tap on touch doesn't leave one stuck open; the aria-label carries
+   the name for assistive tech either way. */
+@media (hover: hover) {
+  .nav-btn::after {
+    content: attr(data-tip);
+    position: absolute;
+    top: calc(100% + 7px);
+    left: 50%;
+    z-index: var(--z-dropdown);
+    padding: 3px 7px;
+    font-family: var(--font-main);
+    font-size: var(--font-size-2xs);
+    font-weight: 400;
+    line-height: 1.3;
+    color: var(--ink);
+    background: var(--paper);
+    border: 1px solid var(--ink);
+    white-space: nowrap;
+    pointer-events: none;
+    opacity: 0;
+    transform: translate(-50%, -2px);
+    transition: opacity 0.12s ease, transform 0.12s ease;
+  }
+
+  .nav-btn:hover::after,
+  .nav-btn:focus-visible::after {
+    opacity: 1;
+    transform: translate(-50%, 0);
+  }
+
+  /* The rail sits hard against the right edge of the topbar, so the last
+     tooltip anchors to its own right edge instead of overflowing the viewport. */
+  .nav-group:last-child .nav-btn:last-child::after {
+    left: auto;
+    right: 0;
+    transform: translate(0, -2px);
+  }
+
+  .nav-group:last-child .nav-btn:last-child:hover::after,
+  .nav-group:last-child .nav-btn:last-child:focus-visible::after {
+    transform: translate(0, 0);
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .nav-btn,
+  .nav-btn::after {
+    transition: none;
+  }
+}
+
+/* Narrow: Donate sheds its label and joins the grid of squares. The buttons go
+   slightly narrower than tall here — the rail is secondary chrome, and the
+   width it gives back goes to the Mode/Vote selectors, which are the controls
+   people actually came to use. */
+@media (max-width: 1080px) {
+  .nav-rail {
+    --nav-btn-size: 32px;
+    --nav-icon-size: 16px;
+  }
+
+  .nav-btn-donate {
+    width: var(--nav-btn-size);
+    padding: 0;
+  }
+
+  .nav-btn-label {
+    display: none;
+  }
+}
+
+@media (max-width: 400px) {
+  .nav-rail {
+    --nav-btn-size: 29px;
+    --nav-icon-size: 15px;
+  }
+}
