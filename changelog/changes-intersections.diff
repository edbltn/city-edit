+  s += "<text x='" + (x(dEnd) - 4) + "' y='" + (y(dEnd) - 8) + "' text-anchor='end'>no change</text>";
+  s += "<text x='" + ((L + W - R) / 2) + "' y='" + (H - 22) + "' text-anchor='middle'>baseline pace (crashes / yr, 2023 → mid-2025)</text>";
+  s += "<text transform='rotate(-90)' x='" + (-(H - B + T) / 2) + "' y='14' text-anchor='middle'>crashes, last 12 months</text>";
+  const order = { stable: 0, cooling: 1, heating: 2 };
