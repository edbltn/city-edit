+<script>
+const DATA = /*__DATA__*/;
+
+const $ = (s) => document.querySelector(s);
+const esc = (s) => String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;");
+const css = (v) => getComputedStyle(document.documentElement).getPropertyValue(v).trim();
+
+// ---- tooltip ----
+const tip = $("#tip");
+function showTip(html, ev) {
+  tip.innerHTML = html;
+  tip.style.display = "block";
+  const pad = 14;
+  let x = ev.clientX + pad, y = ev.clientY + pad;
+  const r = tip.getBoundingClientRect();
+  if (x + r.width > innerWidth - 8) x = ev.clientX - r.width - pad;
+  if (y + r.height > innerHeight - 8) y = ev.clientY - r.height - pad;
+  tip.style.left = x + "px"; tip.style.top = y + "px";
+}
+function hideTip() { tip.style.display = "none"; }
+
+// ---- section 1: PDF movement table ----
+(function () {
+  const verdict = (m) => {
+    if (m.freshRank <= 50) return '<span class="chip heat">still hot · fresh #' + m.freshRank + "</span>";
+    if (m.cool >= 1.0) return '<span class="chip cool">cooled · fresh #' + m.freshRank + "</span>";
+    return '<span class="chip warm">fading · fresh #' + m.freshRank + "</span>";
+  };
+  const rows = DATA.pdfMoves.filter((m) => m.matched).map((m) =>
+    "<tr><td class='r'>" + m.pdfRank + "</td><td>" + esc(m.label) +
+    "<span class='nta'>" + esc(m.nta) + "</span></td><td class='r'>" + m.pdfCrashes +
+    "</td><td class='r'>" + m.baseRate.toFixed(1) + "</td><td class='r'>" + m.f12 +
+    "</td><td>" + verdict(m) + "</td></tr>").join("");
+  $("#pdfTable").innerHTML =
+    "<thead><tr><th class='r'>PDF #</th><th>Intersection</th><th class='r'>PDF crashes ('23→'26)</th>" +
+    "<th class='r'>Baseline pace /yr</th><th class='r'>Last 12 mo</th><th>Where it stands now</th></tr></thead><tbody>" +
+    rows + "</tbody>";
+})();
+
+// ---- section 2: definition tabs ----
+const TABS = [
+  { key: "topFresh", label: "B · Fresh weighted", note: "Last 12 months, injured + 8×killed. Deaths in bold red.", cols: "fresh" },
+  { key: "topFreshPed", label: "D · Pedestrians", note: "Pedestrian victims only, last 12 months, severity-weighted.", cols: "ped" },
+  { key: "topFreshCyc", label: "D · Cyclists", note: "Cyclist victims only, last 12 months, severity-weighted.", cols: "cyc" },
+  { key: "topRecency", label: "C · Recency-decayed", note: "All crashes, half-life 12 months. The recommended poster metric.", cols: "rec" },
+  { key: "topFull", label: "A · Chronic 2023→now", note: "The PDF's definition on fresh data — reproduces its list almost exactly.", cols: "full" },
+  { key: "topNight", label: "F · After dark", note: "Highest night share (9pm–6am) among intersections with ≥4 fresh crashes.", cols: "night" },
+  { key: "manhattanRecency", label: "Manhattan only", note: "Recency-decayed, restricted to Manhattan.", cols: "rec" },
+];
+function cellName(r) { return "<td>" + esc(r.name) + "<span class='nta'>" + esc(r.nta) + " · " + esc(r.boro) + "</span></td>"; }
+function kills(n) { return n > 0 ? " <span class='dead'>+" + n + " killed</span>" : ""; }
+const COLS = {
+  fresh: { head: "<th class='r'>#</th><th>Intersection</th><th class='r'>Score</th><th class='r'>Crashes 12mo</th><th>Victims 12mo</th>",
+    row: (r) => "<td class='r'>" + r.wAll + "</td><td class='r'>" + r.f12 + "</td><td>" + (r.f12pi + r.f12ci) + " injured" + kills(r.f12pk + r.f12ck) + "</td>" },
+  ped: { head: "<th class='r'>#</th><th>Intersection</th><th class='r'>Score</th><th>Pedestrians 12mo</th>",
+    row: (r) => "<td class='r'>" + r.wPed + "</td><td>" + r.f12pi + " injured" + kills(r.f12pk) + "</td>" },
+  cyc: { head: "<th class='r'>#</th><th>Intersection</th><th class='r'>Score</th><th>Cyclists 12mo</th>",
+    row: (r) => "<td class='r'>" + r.wCyc + "</td><td>" + r.f12ci + " injured" + kills(r.f12ck) + "</td>" },
+  rec: { head: "<th class='r'>#</th><th>Intersection</th><th class='r'>Recency score</th><th class='r'>Crashes 12mo</th><th class='r'>Since 2023</th><th class='r'>Last crash</th>",
+    row: (r) => "<td class='r'>" + r.rec + "</td><td class='r'>" + r.f12 + "</td><td class='r'>" + r.crashes + "</td><td class='r'>" + r.last + "</td>" },
