+const TAB_CHANNELS: readonly DebugChannel[] = ALL_CHANNELS;
+
 const STORAGE_KEY = "cityedit_debug";
 const TAB_KEY = "cityedit_tab_name";
 
@@ -63,14 +73,77 @@ export function derror(channel: DebugChannel, ...args: unknown[]): void {
