+    culture: "#743C93",
+    retail: "#5A554D",
+  },
+};
+
 /** Resolve a style id to its MapStyle, falling back to the default. */
 export function getMapStyle(id: string): MapStyle {
   return MAP_STYLES[id] ?? DEFAULT_MAP_STYLE;
