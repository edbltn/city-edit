+           <line x1="4" y1="13.3" x2="12" y2="13.3"/>`,
+  },
+
+  // ── Retail, food & lodging ────────────────────────────────────────────────
+  restaurant: {
+    cat: "retail",
+    body: `<path d="M3.9 2.4 L3.9 5.6 C3.9 6.8, 7.1 6.8, 7.1 5.6 L7.1 2.4"/>
